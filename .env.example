# ═══════════════════════════════════════════════════
# 🔐 Environment Variables — Lumière Restaurant
# ═══════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env

# ─── Database (Neon PostgreSQL) ───
# Pooled connection for the application runtime.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&connect_timeout=30"

# Direct connection for Prisma migrations.
# Same as DATABASE_URL but without connection pooling.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# ─── Authentication (Auth.js v5) ───
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="your-64-char-random-string-here"

# ─── Email Provider ───
# console = print to terminal (development)
# resend  = real delivery (requires API key)
EMAIL_PROVIDER="console"

# ─── Optional ───
# Public URL used for OG images and sitemap.
# Defaults to the Vercel production URL if omitted.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ─── Email Provider ───
EMAIL_PROVIDER="console"          # console | resend
RESEND_API_KEY=""                 # from https://resend.com/api-keys
EMAIL_FROM="Lumière <onboarding@resend.dev>"   # or your verified domain
EMAIL_REPLY_TO="hello@lumiere.example"         # optional