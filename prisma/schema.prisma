// هذا هو ملف مخطط قاعدة البيانات لمشروع Lumière Restaurant
// كل جدول نكتبه هنا، سيصبح جدولاً حقيقياً في قاعدة البيانات
// المرجع: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════
// 📂 Category — تصنيفات الأطباق
// ═══════════════════════════════════════════════════
model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  nameEn       String?    @unique
  slug         String     @unique
  description  String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // 🔗 Relation: one category → many items
  items        MenuItem[]

  @@map("categories")
}

// ═══════════════════════════════════════════════════
// 🍽️ MenuItem — الأطباق
// ═══════════════════════════════════════════════════
model MenuItem {
  id             String   @id @default(cuid())
  name           String
  nameEn         String?
  slug           String   @unique
  description    String?
  descriptionEn  String?
  price          Float
  imageUrl    String?
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // NEW: Track available stock for delivery
  stock       Int         @default(100) 
  
  // NEW: Relation to order items
  orderItems  OrderItem[]

  // 🔗 العلاقة: كل طبق ينتمي لتصنيف واحد
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("menu_items")
}

// ═══════════════════════════════════════════════════
// 🪑 Table — طاولات المطعم
// ═══════════════════════════════════════════════════
model Table {
  id           String   @id @default(cuid())
  number       Int      @unique
  capacity     Int
  location     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 🔗 العلاقة: طاولة واحدة → حجوزات كثيرة
  reservations Reservation[]

  @@map("tables")
}

// ═══════════════════════════════════════════════════
// 📅 Reservation — الحجوزات
// ═══════════════════════════════════════════════════
model Reservation {
  id              String   @id @default(cuid())
  guestName       String
  guestEmail      String
  guestPhone      String
  guestsCount     Int
  reservationDate DateTime
  durationMinutes Int      @default(90)
  status          String   @default("PENDING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 🔗 العلاقة: كل حجز مرتبط بطاولة واحدة
  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  @@map("reservations")
}

// ═══════════════════════════════════════════════════
// 👤 User — مستخدمو لوحة التحكم (مسؤولون وموظفون)
// ═══════════════════════════════════════════════════
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("STAFF")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[] 
  announcements Announcement[]

  @@map("users")
}

// ═══════════════════════════════════════════════════
// 📋 AuditLog — سجل الإجراءات (لمساءلة الموظفين)
// ═══════════════════════════════════════════════════
// يُسجّل الإجراءات الحساسة التي يقوم بها الموظفون فقط.
//
// ⚠️ **قرار معماري مهم:**
//   • لا علاقة (`relation`) مع `User` — عن قصد.
//   • السجل يجب أن يبقى صامداً حتى لو حُذف المستخدم.
//   • نُخزّن `userName` كـ snapshot وقت الإجراء.
//   • نُخزّن `entityName` كـ snapshot وقت الإجراء.
//
// `severity` للفلترة السريعة:
//   • info     → إجراءات عادية (إنشاء/تعديل)
//   • warning  → إجراءات حساسة (تعطيل/إلغاء)
//   • critical → إجراءات خطيرة (حذف)

model AuditLog {
  id         String   @id @default(cuid())

  // ─── من فعل الإجراء؟ ───
  userId     String?  // null لو حُذف المستخدم
  userName   String   // snapshot وقت الإجراء

  // ─── ماذا حدث؟ ───
  action     String   // "CREATE" | "UPDATE" | "DELETE"
  entity     String   // "MenuItem" | "Table" | "User" | "Reservation"
  entityId   String
  entityName String   // snapshot وقت الإجراء

  // ─── تفاصيل التغيير ───
  severity   String   @default("info")  // info | warning | critical
  changes    Json?    // { before: {...}, after: {...} }

  // ─── متى؟ ───
  createdAt  DateTime @default(now())

  // ─── فهارس للفلترة السريعة ───
  @@index([createdAt])
  @@index([severity])
  @@index([entity])
  @@index([userId])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════
// ⭐ Review — تقييمات العملاء
// ═══════════════════════════════════════════════════
// ⚠️ لا علاقة بـ `Reservation` — العميل لا يحتاج حجزاً سابقاً.
// (التقييمات المرتبطة بالحجز = ميزة "Review Invitations" في Roadmap)

model Review {
  id          String   @id @default(cuid())

  // ─── بيانات العميل ───
  guestName   String
  guestEmail  String?  // اختياري — للإدارة فقط، لا يُعرَض

  // ─── التقييم ───
  rating      Int      // 1..5 نجوم
  comment     String

  // ─── الحالة ───
  status      String   @default("PENDING")  // PENDING | APPROVED | REJECTED

  // ─── تواريخ ───
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ─── فهارس للفلترة السريعة ───
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

// ═══════════════════════════════════════════════════
// ⚙️ Setting — site-wide key/value settings
// ═══════════════════════════════════════════════════
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ═══════════════════════════════════════════════════
// 🛒 Order — Food Delivery / Takeaway
// ═══════════════════════════════════════════════════
model Order {
  id                    String      @id @default(cuid())
  
  // Guest details (Checkout doesn't require login)
  guestName             String
  guestEmail            String
  guestPhone            String
  
  // Fulfillment (Delivery OR Dine-in)
  deliveryAddress       String?
  tableNumber           String?

  // Payment & Status
  status                String      @default("PENDING") // PENDING, PAID, PREPARING, DELIVERED, CANCELLED
  paymentMethod         String      @default("CARD")    // CARD | CASH
  totalAmount           Float
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?     @unique
  
  // Relations
  userId                String?     // Optional: link to a user account if logged in
  user                  User?       @relation(fields: [userId], references: [id])
  items                 OrderItem[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Indexes for admin dashboard performance
  @@index([status])
  @@index([createdAt])
  @@map("orders")
  @@index([guestEmail])
}

// ═══════════════════════════════════════════════════
// 📦 OrderItem — Snapshots of purchased items
// ═══════════════════════════════════════════════════
model OrderItem {
  id           String   @id @default(cuid())
  
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  
  quantity     Int
  priceAtOrder Float    // CRITICAL: Snapshot the price at the time of purchase

  @@map("order_items")
}

// ═══════════════════════════════════════════════════
// 📢 Announcement — Admin/Staff Alerts & Announcements
// ═══════════════════════════════════════════════════
model Announcement {
  id          String   @id @default(cuid())
  title       String?  
  message     String
  type        String   @default("INFO") 
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  
  // NEW: Track source (MANUAL or SYSTEM)
  source      String   @default("MANUAL") 
  triggerKey  String?  @unique // e.g., "low_stock_5", "high_order_500"

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([isActive])
  @@map("announcements")
}

// ═══════════════════════════════════════════════════
// ⚙️ SystemRule — Admin-defined conditions for auto-alerts
// ═══════════════════════════════════════════════════
model SystemRule {
  id        String   @id @default(cuid())
  key       String?  @unique // e.g., "default_low_stock"
  name      String   // e.g., "High Order Alert"
  metric    String   // "STOCK_LEVEL", "ORDER_TOTAL", "PENDING_RESERVATIONS"
  threshold Float    // e.g., 10 (for stock), 500 (for amount)
  type      String   @default("WARNING") // INFO, WARNING, SUCCESS, URGENT
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_rules")
}